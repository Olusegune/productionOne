{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Production One",
  "version": "0.46.5",
  "identifier": "com.productionguy.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Production One — Your AI Production Department",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": true,
        "label": "main",
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Production One",
        "width": 960,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Your AI Production Department",
    "longDescription": "Windows-first AI preproduction and visual development studio.",
    "copyright": "Copyright © 2026 Production One",
    "publisher": "Production One",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/project-file.ico": "project-file.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "pone"
        ],
        "name": "Production One Project",
        "description": "Production One project",
        "role": "Editor",
        "mimeType": "application/x-production-one-project"
      },
      {
        "ext": [
          "pguy"
        ],
        "name": "Production Guy Project",
        "description": "Production Guy project (opens in Production One)",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "ProductionOne"
}
